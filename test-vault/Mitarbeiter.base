improved-bases:
  fields:
    Team:
      type: relation
      base: Teams.base
      multiple: true
    Role:
      type: select
      multiple: false
      options:
        Developer: blue
        Designer: pink
        Product Owner: orange
filters:
  and:
    - file.inFolder("Mitarbeiter")
views:
  - type: table
    name: Tabelle
    order:
      - file.name
      - Team
      - Role
      - Status
    columnSize:
      note.team: 237
