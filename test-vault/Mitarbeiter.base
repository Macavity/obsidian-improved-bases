improved-bases:
  fields:
    Team:
      type: relation
      base: Teams.base
      multiple: true
    Role:
      type: select
      multiple: false
      options:
        Developer: blue
        Designer: pink
        Product Owner: orange
filters:
  and:
    - file.inFolder("Mitarbeiter")
views:
  - type: table
    name: Tabelle
    order:
      - file.name
      - Team
      - Role
      - Status
    columnSize:
      note.team: 237
      note.Role: 133
  - type: table
    name: Leads
    filters:
      or:
        - Role == "Manager"
        - Role == "Product Owner"
    order:
      - file.name
      - Role
    sort:
      - property: file.name
        direction: DESC
  - type: table
    name: Nach Rolle
    groupBy:
      property: Role
      direction: ASC
    order:
      - file.name
      - Role
