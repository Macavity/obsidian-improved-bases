{
	"name": "improved-bases",
	"version": "0.0.1",
	"description": "Relations and colored select fields for Obsidian Bases.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"preinstall": "node scripts/npm-proxy.mjs",
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs build",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"quality": "fallow",
		"audit": "fallow audit",
		"check": "pnpm typecheck && pnpm lint && pnpm test && pnpm quality",
		"lint": "node scripts/lint-wrapper.mjs",
		"lint:fix": "node scripts/lint-wrapper.mjs --fix",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"vault:link": "node scripts/vault-link.mjs",
		"vault:link-test": "node scripts/vault-link.mjs --test",
		"vault:open": "node scripts/vault-open.mjs",
		"vault:reset": "node scripts/vault-reset.mjs",
		"reload": "node scripts/reload.mjs",
		"perf": "pnpm vault:reset && pnpm build && pnpm reload && node scripts/perf.mjs",
		"smoke": "pnpm vault:reset && pnpm build && pnpm reload && node scripts/smoke.mjs"
	},
	"author": "Alexander Pape",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Macavity/obsidian-improved-bases.git"
	},
	"bugs": {
		"url": "https://github.com/Macavity/obsidian-improved-bases/issues"
	},
	"homepage": "https://github.com/Macavity/obsidian-improved-bases#readme",
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"@eslint/json": "^0.14.0",
		"@types/node": "^16.11.6",
		"@typescript-eslint/parser": "^8.50.1",
		"esbuild": "0.25.5",
		"eslint": "^9.39.1",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"fallow": "3.33.1",
		"globals": "14.0.0",
		"happy-dom": "^20.14.5",
		"obsidian": "1.13.0",
		"typescript": "5.8.3",
		"typescript-eslint": "^8.50.1",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"monkey-around": "^3.0.0",
		"yaml": "^2.9.1"
	},
	"packageManager": "pnpm@10.20.0"
}
